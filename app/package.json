{
  "name": "drawing-installation-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist-main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 dist-main/index.js && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0",
    "@dimforge/rapier3d-compat": "^0.13.1",
    "electron-store": "^8.2.0"
  }
}
